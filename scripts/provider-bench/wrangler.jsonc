{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voice-agent-provider-bench",
  "main": "index.js",
  "compatibility_date": "2026-04-05",
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": ["ELEVENLABS_API_KEY", "ELEVENLABS_VOICE_ID", "TOGETHER_API_KEY", "GROQ_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  }
}
